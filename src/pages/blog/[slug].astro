---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  let posts: Awaited<ReturnType<typeof getCollection<'blog'>>> = [];
  try { posts = await getCollection('blog'); } catch { posts = []; }
  return posts.map((post) => {
    const slug = post.data.slug || post.id.replace(/\.mdx?$/, '').replace(/^.*\//, '');
    return { params: { slug }, props: { post, slug } };
  });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
const modified = post.data.updatedDate;
const updatedDate = modified?.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  image: new URL(post.data.hero?.src ?? SITE.ogImage, SITE.url).toString(),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  wordCount: post.data.wordCount,
  mainEntityOfPage: new URL(`/blog/${slug}/`, SITE.url).toString(),
  audience: { '@type': 'PeopleAudience', suggestedMinAge: 18 },
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const relatedPosts = (await getCollection('blog'))
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => ({
    post: candidate,
    sharedTags: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .filter((candidate) => candidate.sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3);
---
<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.hero?.src}
  imageAlt={post.data.hero?.alt}
  ogType="article"
  jsonLd={post.data.faq.length ? [jsonLd, faqJsonLd] : jsonLd}
>
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  <meta slot="head" property="article:modified_time" content={(post.data.updatedDate ?? post.data.date).toISOString()} />
  <article class="article wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Journal</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>
    <p class="kicker" style="margin-top:2rem">Journal</p>
    <h1>{post.data.title}</h1>
    <p class="article-summary">{post.data.description}</p>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>Published {date}</time>
      {modified && <> · <time datetime={modified.toISOString()}>Updated {updatedDate}</time></>}
      {post.data.wordCount ? ` · ${post.data.wordCount.toLocaleString('en-US')} words` : ''}
      {post.data.wordCount ? ` · about ${Math.max(1, Math.round(post.data.wordCount / 250))} min read` : ''}
    </p>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags" style="margin:-1.5rem 0 2rem">
        {post.data.tags.map((t) => <a class="tag" href={`/blog/tag/${t}/`}>{t.replace(/-/g, ' ')}</a>)}
      </div>
    )}
    {post.data.hero && (
      <figure class="article-hero">
        <img src={post.data.hero.src} alt={post.data.hero.alt} decoding="async" fetchpriority="high" />
        {post.data.hero.caption && <figcaption>{post.data.hero.caption}</figcaption>}
      </figure>
    )}
    {sections.length > 3 && (
      <nav class="article-toc" aria-label="In this guide">
        <p>In this guide</p>
        <ol>
          {sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
          {post.data.faq.length > 0 && <li><a href="#questions">Frequently asked questions</a></li>}
        </ol>
      </nav>
    )}
    <div class="article-body prose">
      <Content />
      {post.data.faq.length > 0 && (
        <section aria-labelledby="questions">
          <h2 id="questions">Frequently asked questions</h2>
          {post.data.faq.map((item) => (
            <div class="article-faq">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </section>
      )}
    </div>
    {relatedPosts.length > 0 && (
      <aside class="article-related" aria-labelledby="related-guides">
        <h2 id="related-guides">Related guides</h2>
        <ul>
          {relatedPosts.map(({ post: related }) => (
            <li><a href={`/blog/${related.data.slug || related.id.replace(/\.mdx?$/, '').replace(/^.*\//, '')}/`}>{related.data.title}</a></li>
          ))}
        </ul>
      </aside>
    )}
    <p style="margin-top:3.5rem">
      <a href="/blog/">← All essays</a>
      <span class="muted"> · </span>
      <a href="/shop">The collection</a>
    </p>
  </article>
</Base>
