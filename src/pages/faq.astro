---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const faqs = [
  {
    q: 'What does AIB Robot sell today?',
    a: `${SITE.legalName} is a category site for AI bionic and companion robots. Today the AI figure is a non-walking facial-expression head on a 164 cm F-cup body. The other products are adult companion figures, 157 cm and above. Those companion figures are transitional products in this catalog. They are not walking household robots. Checkout is an order request, not a card payment.`,
  },
  {
    q: 'Are the prices current?',
    a: 'STPE companions are shown at $2,199, beside a previous list price of $2,599, as of 15 November 2026. Silicone companions use suggested retail from a 4 October 2025 list, $1,900 or $1,950 depending on the body. The expression-head figure is listed at $3,099 as of 15 November 2026. Warehouse availability is taken from lists received in November 2026. Stock and the final price are reconfirmed in writing before you are asked to pay. We do not publish unit counts.',
  },
  {
    q: 'Is a figure on a warehouse page actually in stock today?',
    a: 'Not automatically. Figures on the US and EU warehouse pages are taken from warehouse lists we received in November 2026. We will ask whether a specific unit is still there — and confirm the head, skin, and material actually available — before you pay. We do not publish a delivery-day range or a unit count.',
  },
  {
    q: 'Why is there no “Buy now” button?',
    a: 'Checkout on this site is an order request, not a payment. We will confirm inventory and the final price, then arrange payment separately once a processor that accepts this category is in place. We do not collect card numbers on this site.',
  },
  {
    q: 'What is the AI voice box, and is it the same as the AI robot?',
    a: 'No. The AI voice box is an optional audio add-on, offered at $100 pending confirmation. It does not depend on connecting an expression head to a home Wi-Fi network. The AI figure is a separate product: the 164 cm F-cup expression head. It does not walk. See the Voice box and AI robots pages.',
  },
  {
    q: 'Will the AI figure work on my home Wi-Fi in the US or Europe?',
    a: 'We do not promise that. Notes we have seen describe trouble on networks away from where the head was set up, and the head’s instructions ask the user to check the network if none is found. If you inquire, we confirm current connectivity guidance before dispatch. The voice box does not depend on that connection. The figure does not walk.',
  },
  {
    q: 'Do you sell short, anime, or child-like figures?',
    a: 'No. This collection is adult-realistic only, 157 cm and above. We do not sell cartoon or anime lines, or any child-like figure.',
  },
  {
    q: 'Can I return a figure if I change my mind?',
    a: 'Return and withdrawal rights depend on the law applicable to your order. Where EU consumer withdrawal rights apply, online purchases generally have a 14-day withdrawal period, with specific exceptions for qualifying personalised goods and sealed hygiene-sensitive goods unsealed after delivery. We confirm applicable terms before accepting an order. If your figure arrives damaged, incomplete or faulty, contact us promptly with photographs. Mandatory consumer rights remain applicable. See the Returns page for details.',
  },
  {
    q: 'How is the package labelled?',
    a: 'We request unmarked outer packaging, and we confirm the packing method with your order. We will not misdeclare the contents. We do not ship to jurisdictions where these products are prohibited.',
  },
  {
    q: 'Do the measurements include a particular head?',
    a: 'We publish the measurements as they appear on the notes named on each product page. Where a document is silent, we omit the figure rather than invent one. Whether a listed height includes a specific head is something we will confirm for your unit. Head pairing is chosen with your inquiry.',
  },
  {
    q: 'Can I order a custom head, skin, or other option?',
    a: 'Yes, as a request. A 4 October 2025 options sheet for the silicone companions lists skin tones, eye colours, hair, a sound option, breathing and suction functions, and other items. Heads on the STPE companions are chosen separately. We confirm current availability and price before payment.',
  },
  {
    q: 'Do you ship internationally?',
    a: 'We can discuss destinations that lawfully allow these products. Shipping cost and lead time are confirmed before payment. We will not ship where the product is prohibited, and we will not misdeclare customs documents. Duties and taxes, where they apply, are for the recipient unless we have agreed otherwise in writing.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Frequently asked questions"
  description="What AIB Robot sells today, public prices, warehouse lists, the expression head, Wi-Fi, the voice box, returns, and what this site will not sell."
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header class="page-hero">
      <p class="kicker">FAQ</p>
      <h1>Questions we would rather answer once, clearly.</h1>
    </header>
    <div style="max-width:46rem;padding-bottom:4.5rem">
      {faqs.map((f) => (
        <section style="margin-bottom:2.25rem;padding-bottom:2rem;border-bottom:1px solid var(--line)">
          <h2 style="font-size:1.55rem">{f.q}</h2>
          <p style="margin:0;color:var(--ink-2)">{f.a}</p>
        </section>
      ))}
      <p>If your question is not here, <a href="/contact">write to us</a>.</p>
    </div>
  </div>
</Base>
