---
import Base from '../../layouts/Base.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { products, getProduct, startingPrice, isWarehouseStock } from '../../data/products';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return products
    .filter((p) => p.collection === 'companion')
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!);
if (!product) throw new Error('Unknown product ' + slug);

const price = startingPrice(product);
const offerDescription =
  product.priceKind === 'suggested-retail'
    ? 'Suggested retail from a 4 October 2025 list; reconfirmed before payment.'
    : product.priceKind === 'current-price'
      ? 'Current price as of 15 November 2026, shown beside the previous list price; reconfirmed before payment.'
      : 'Listed price as of 15 November 2026; reconfirmed before payment.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  brand: { '@type': 'Brand', name: SITE.name },
  description: product.summary,
  category: 'Adult companion figure',
  audience: { '@type': 'PeopleAudience', suggestedMinAge: 18 },
  offers: {
    '@type': 'Offer',
    url: new URL(`/products/${product.slug}`, SITE.url).toString(),
    priceCurrency: 'USD',
    price: price,
    priceValidUntil: '2026-12-31',
    availability: isWarehouseStock(product)
      ? 'https://schema.org/InStock'
      : 'https://schema.org/PreOrder',
    itemCondition: 'https://schema.org/NewCondition',
    description: offerDescription,
  },
};
---
<Base
  title={product.title}
  description={product.summary}
  ogType="product"
  jsonLd={jsonLd}
>
  <ProductDetail product={product} />
</Base>
